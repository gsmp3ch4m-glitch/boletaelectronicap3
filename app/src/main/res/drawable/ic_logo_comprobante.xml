<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Tech Arcs / Circuit Circles Background -->
    <path
        android:pathData="M20,50 A30,30 0 0,1 80,50"
        android:strokeWidth="1.5"
        android:strokeColor="#81C784"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M80,50 A30,30 0 0,1 20,50"
        android:strokeWidth="1.5"
        android:strokeColor="#2196F3"
        android:strokeLineCap="round"/>
        
    <!-- Tech Nodes (Dots) -->
    <path android:pathData="M20,50 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" android:fillColor="#2196F3"/>
    <path android:pathData="M80,50 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" android:fillColor="#81C784"/>
    <path android:pathData="M50,20 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" android:fillColor="#81C784"/>
    <path android:pathData="M50,80 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" android:fillColor="#2196F3"/>

    <!-- Receipt Body with Gradient -->
    <path
        android:pathData="M35,25 h20 l10,10 v40 l-5,-3 l-5,3 l-5,-3 l-5,3 l-5,-3 l-5,3 v-53 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="25"
                android:startX="35"
                android:endY="75"
                android:endX="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF4FC3F7"/> <!-- Light Blue -->
                <item android:offset="1.0" android:color="#FF66BB6A"/> <!-- Green -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Folded Corner Effect -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M55,25 l10,10 h-10 z"/>

    <!-- Checkmark (White) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,38 l3,3 l7,-7 l1.5,1.5 l-8.5,8.5 l-4.5,-4.5 z"/>

    <!-- Content Lines (White, Semi-transparent) -->
    <path
        android:fillColor="#CCFFFFFF"
        android:pathData="M40,48 h20 v2 h-20 z"/>
    <path
        android:fillColor="#CCFFFFFF"
        android:pathData="M40,54 h20 v2 h-20 z"/>
    <path
        android:fillColor="#CCFFFFFF"
        android:pathData="M40,60 h12 v2 h-12 z"/>

</vector>
