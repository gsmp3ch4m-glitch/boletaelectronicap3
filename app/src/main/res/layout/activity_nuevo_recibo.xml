<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.ReciboP3.AppBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Widget.ReciboP3.Toolbar"
            app:title="@string/nuevo_recibo_titulo"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Número y Fecha -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.ReciboP3.Card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Tipo de Documento -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:hint="@string/tipo_documento">

                        <AutoCompleteTextView
                            android:id="@+id/actvTipoDocumento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:text="@string/tipo_recibo" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recibo_numero"
                        android:textAppearance="@style/TextAppearance.ReciboP3.Caption"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvNumeroRecibo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="REC-000001"
                        android:textAppearance="@style/TextAppearance.ReciboP3.Headline2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recibo_fecha"
                        android:textAppearance="@style/TextAppearance.ReciboP3.Caption"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFecha"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="01/01/2026 - 10:30 AM"
                            android:textAppearance="@style/TextAppearance.ReciboP3.Body" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCambiarFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recibo_cambiar_fecha"
                            style="@style/Widget.Material3.Button.TextButton" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cliente -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cliente_titulo"
                android:textAppearance="@style/TextAppearance.ReciboP3.Headline2"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.ReciboP3.TextInputLayout"
                android:hint="@string/cliente_nombre">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClienteNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.ReciboP3.TextInputLayout"
                android:hint="@string/cliente_documento">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClienteDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.ReciboP3.TextInputLayout"
                android:hint="@string/cliente_telefono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClienteTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.ReciboP3.TextInputLayout"
                android:hint="@string/cliente_direccion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClienteDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Detalle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detalle_titulo"
                    android:textAppearance="@style/TextAppearance.ReciboP3.Headline2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detalle_agregar"
                    style="@style/Widget.ReciboP3.Button" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- Pago -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pago_titulo"
                android:textAppearance="@style/TextAppearance.ReciboP3.Headline2"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rgPagoTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbPagoTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pago_total"
                    android:checked="true" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbPagoParcial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pago_parcial" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvMontoTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monto Total: S/ 0.00"
                android:textAppearance="@style/TextAppearance.ReciboP3.Body"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.ReciboP3.TextInputLayout"
                android:hint="@string/monto_pagado">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMontoPagado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvSaldoPendiente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saldo Pendiente: S/ 0.00"
                android:textAppearance="@style/TextAppearance.ReciboP3.Body"
                android:textColor="@color/error"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerarPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/generar_pdf"
                style="@style/Widget.ReciboP3.Button" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
